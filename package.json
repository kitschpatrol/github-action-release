{
  "name": "github-action-release",
  "version": "3.0.2",
  "private": true,
  "description": "GitHub Action for creating GitHub Releases.",
  "keywords": [
    "github-action",
    "action"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitschpatrol/github-action-release.git"
  },
  "author": {
    "name": "Doug Tangren",
    "email": "d.tangren@gmail.com",
    "url": "https://lessis.me/"
  },
  "contributors": [
    {
      "name": "Eric Mika",
      "email": "eric@ericmika.com",
      "url": "https://ericmika.com"
    }
  ],
  "main": "lib/main.js",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts --minify",
    "build-debug": "rolldown -c rolldown.config.ts --sourcemap",
    "clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
    "fix": "ksc-prettier fix",
    "lint": "ksc-prettier lint",
    "release": "pnpm run build && bumpp --commit 'Release: %s' --all && ./scripts/sync-major-tag.sh",
    "test": "vitest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "glob": "^13.0.6",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@kitschpatrol/prettier-config": "^7.6.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "bumpp": "^12.3.0",
    "rolldown": "^1.2.12",
    "shx": "^0.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  }
}
